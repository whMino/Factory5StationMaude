---------------------------------------------------------------------------
--- Modulo che fornisce funzioni di validazione sulla configurazione:   ---
--- conteggio pallet, recupero stazione per id, assenza di stazioni     ---
--- duplicate                                                           ---
---------------------------------------------------------------------------

mod VALIDATION is
  protecting NAT .
  protecting BOOL .
  protecting CONFIG .

  op validConfig : Config -> Bool .
  op countPallets : Config -> Nat .
  op getStation : Config StationId -> Station .
  op noneStation : -> Station [ctor] .
  op noDuplicateStations : Config -> Bool .

  vars CF : Config .
  vars S S1 S2 : StationId .
  var MS : MachineState .
  vars B1 B2 : Buffer .
  var PID : PalletId .
  var T : ProductType .

  eq validConfig(CF) = noDuplicateStations(CF) .

  eq countPallets(none) = 0 .
  eq countPallets(p(PID, T) CF) = 1 + countPallets(CF) .
  eq countPallets(< S, MS, B1, B2 > CF)
    = size(content(B1)) + size(content(B2)) + countPallets(CF) .

  eq getStation(none, S) = noneStation .
  eq getStation(< S:StationId, MS, B1, B2 > CF, S:StationId) = < S:StationId, MS, B1, B2 > .
  eq getStation(< S1:StationId, MS, B1, B2 > CF, S:StationId)
    = getStation(CF, S) [owise] .

  eq noDuplicateStations(none) = true .
  eq noDuplicateStations(< S, MS, B1, B2 > CF)
    = (getStation(CF, S) == noneStation)
      and noDuplicateStations(CF) .
endm