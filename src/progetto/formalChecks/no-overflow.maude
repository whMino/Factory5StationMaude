---------------------------------------------------------------------------
--- Modulo per verificare che nessun buffer del sistema superi mai      ---
--- la propria capacità massima in nessuna configurazione raggiungibile ---
---------------------------------------------------------------------------

mod NO-OVERFLOW is
  protecting SYSTEM .
  protecting CONFIG .
  protecting TYPES .

  op checkNoOverflow : Config -> Bool .
  op bufferNoOverflow : Buffer -> Bool .

  var CF : Config .
  var SId : StationId .
  var MS : MachineState .
  vars B1 B2 B : Buffer .

  eq bufferNoOverflow(B) = size(content(B)) <= cap(B) .

  eq checkNoOverflow(none) = true .
  eq checkNoOverflow(< SId, MS, B1, B2 > CF) =
    bufferNoOverflow(B1) and bufferNoOverflow(B2) and checkNoOverflow(CF) .
endm